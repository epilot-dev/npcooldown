{
  "name": "npcooldown",
  "version": "0.1.2",
  "description": "Protect yourself from npm supply chain attacks. One command sets up minimumReleaseAge cooldowns across npm, pnpm, Yarn, and Bun globally.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "npcooldown": "./bin/cli.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "start": "node dist/index.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "npm",
    "pnpm",
    "yarn",
    "bun",
    "supply-chain",
    "supply-chain-attack",
    "security",
    "minimumReleaseAge",
    "cooldown",
    "shai-hulud",
    "malware",
    "cli"
  ],
  "author": "epilot GmbH <v.kuosmanen@epilot.cloud>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/epilot-dev/npcooldown.git"
  },
  "bugs": {
    "url": "https://github.com/epilot-dev/npcooldown/issues"
  },
  "homepage": "https://github.com/epilot-dev/npcooldown#readme",
  "dependencies": {
    "@inquirer/prompts": "^5.0.0",
    "chalk": "^5.3.0",
    "execa": "^8.0.1",
    "ini": "^4.1.0",
    "js-yaml": "^4.1.0",
    "smol-toml": "^1.3.0"
  },
  "devDependencies": {
    "@types/ini": "^4.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  }
}
